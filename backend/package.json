{
  "name": "tracker-backend",
  "version": "1.0.0",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "jest --runInBand --forceExit",
    "test:coverage": "jest --runInBand --coverage --forceExit",
    "verify": "npm test && npm audit",
    "db:generate": "prisma generate",
    "db:migrate:deploy": "prisma migrate deploy",
    "deploy:prepare": "npm run db:generate && npm run db:migrate:deploy",
    "tracking:repair-display-history": "node scripts/repair-display-history.js",
    "format": "prettier --write .",
    "seed": "node prisma-seed.js",
    "db:fresh": "node scripts/fresh-database.js --confirm --mode=demo",
    "db:fresh:clean": "node scripts/fresh-database.js --confirm --mode=clean",
    "admin:ensure": "node scripts/ensure-admin.js",
    "verify:tracking": "node scripts/verify-carrier-scraping.js",
    "sync:carriers": "node scripts/sync-all-carriers.js",
    "dispatch:whatsapp": "node scripts/dispatch-pending-whatsapp.js",
    "dispatch:whatsapp:missing": "node scripts/dispatch-missing-whatsapp.js",
    "phenix:inspect": "node scripts/inspect-phenix.js",
    "phenix:sync": "node scripts/sync-phenix-cli.js",
    "phenix:sync-20": "node scripts/sync-phenix-cli.js 20 ALL",
    "phenix:sync-30": "node scripts/sync-phenix-cli.js 30 ALL",
    "phenix:sync-all": "node scripts/sync-phenix-cli.js 45 ALL",
    "phenix:deliver-old": "node scripts/shift-older-shipments-delivered.js 7",
    "phenix:deliver-30": "node scripts/shift-older-shipments-delivered.js 30",
    "phenix:backfill-eta": "node scripts/backfill-estimated-delivery.js",
    "phenix:reconcile": "node scripts/reconcile-phenix-records.js",
    "phenix:audit-ote": "node scripts/audit-phenix-ote.js",
    "phenix:carriers": "node scripts/lookup-all-phenix-carriers.js",
    "finance:audit": "node scripts/verify-finance-and-whatsapp.js"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "Shipment tracking backend API",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "axios": "^1.13.3",
    "bcryptjs": "^3.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "decimal.js": "^10.6.0",
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "express-http-context": "^2.0.1",
    "express-rate-limit": "^8.2.1",
    "express-validator": "^7.2.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.3",
    "mathjs": "^15.1.1",
    "uuid": "^13.0.0",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "prisma": "^6.19.3",
    "supertest": "^6.3.4"
  }
}
